LOG_LEVEL=INFO
LOG_FORMAT=console
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/palinsesto

# Browser sign-in (Auth0). Callback: <BROWSER_ORIGIN>/api/auth/callback
BROWSER_ORIGIN=http://127.0.0.1:5173
BROWSER_CSRF_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_EMAILS=["you@example.com"]

# Encrypts each Workspace's Spotify client secret and refresh token. Generate with
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_SECRET_KEY=
